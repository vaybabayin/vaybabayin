TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Notification chat(s), comma-separated. Send /test to the bot to see a chat's ID.
# Chats listed here keep receiving notifications after every redeploy.
TELEGRAM_CHANNEL_ID=-100chatid
TOKEN_CONTRACT=0xAe5F595803B2AA4D07aF8b392e535876a974a296
NFT_CONTRACT=0x154dacdec3459e551fc426f82e78e518a1f8f984
ALCHEMY_API_KEY=
RPC_URL_1=
RPC_URL_2=
# Where bot-state.json (chats + NFT tier map) is kept. Point it at a Railway
# volume to keep it across redeploys; defaults to the volume mount or app dir.
DATA_DIR=
# Series sizes are learned from chain; these are only used until then.
SC1_TARGET=200
SC2_TARGET=200
SC3_TARGET=250
